# Backend Scaffold Configuration (Phase 11B)
# Environment
NODE_ENV=development

# Server
PORT=3000

# API
API_PREFIX=/api

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Database (Phase 11C)
# PostgreSQL connection string for local development
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://clinic_user:dev_password_change_me@localhost:5432/clinic_crm_dev

# Database SSL (set to 'true' for production)
DATABASE_SSL=false

# Database query logging (set to 'true' for development debugging)
DB_LOG_QUERIES=false

# Authentication (Phase 11D)
# JWT secret (minimum 32 characters, use strong secret in production)
JWT_SECRET=dev_jwt_secret_change_me_in_production_min_32_chars

# JWT token expiration times
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin configuration (only needed when AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com
# Private key with escaped newlines: replace actual newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Authentication mode: 'mock' for development, 'firebase' for production
AUTH_MODE=mock

# Document Storage (Phase 11J)
# Storage driver: 'local' for development, 's3' for production
DOCUMENT_STORAGE_DRIVER=local

# Local storage path (relative to backend directory)
DOCUMENT_LOCAL_STORAGE_PATH=./storage/documents

# Maximum file size in MB
DOCUMENT_MAX_FILE_SIZE_MB=10

# Allowed MIME types (comma-separated)
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# S3/MinIO configuration (only needed when DOCUMENT_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

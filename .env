# Data Mode Configuration
# Options: "local" (localStorage/demo mode) or "api" (backend API mode)
# Default: "local" - API mode must be opt-in
VITE_DATA_MODE=local

# API Base URL (used only when VITE_DATA_MODE=api)
# Default: http://localhost:4000/api
VITE_API_BASE_URL=http://localhost:4000/api

# API Timeout in milliseconds (optional, default: 30000)
VITE_API_TIMEOUT_MS=30000

# Enable API debug logging (optional, default: false)
# WARNING: Do not enable in production - may log request/response details
VITE_ENABLE_API_DEBUG=false

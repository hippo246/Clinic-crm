# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Rust Backend API URL
VITE_API_URL=https://127.0.0.1:8443

# Data Mode Configuration
# Options: "local" (localStorage/demo mode) or "api" (backend API mode)
# Default: "local" - API mode must be opt-in
VITE_DATA_MODE=local

# API Base URL (used only when VITE_DATA_MODE=api)
# Default: http://localhost:4000/api
VITE_API_BASE_URL=http://localhost:4000/api

# API Timeout in milliseconds (optional, default: 30000)
VITE_API_TIMEOUT_MS=30000

# Enable API debug logging (optional, default: false)
# WARNING: Do not enable in production - may log request/response details
VITE_ENABLE_API_DEBUG=false
